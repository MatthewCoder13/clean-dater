{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
"permissions": [
    "core:default",
    "store:default",
    "dialog:default",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "description": "Дозвіл записувати PDF у місце, обране користувачем у діалозі «Зберегти»",
      "allow": [
        { "path": "**" }
      ]
    }
  ]
}